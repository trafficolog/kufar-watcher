{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron", "electron-vite/node", "vitest/globals"]
  },
  "include": ["electron/**/*.ts", "shared/**/*.ts", "electron.vite.config.ts", "tests/**/*.ts"]
}
